# Copy this file to .env and fill in real values. Never commit .env.
#
# Shared password to unlock the app (see README for how to generate one).
APP_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Where the app stores its data (snapshots.json + backups). Defaults to ./data.
DATA_DIR=./data

# Port the server listens on.
PORT=3000

# Set to "false" only for local http (non-TLS) development. Leave unset/"true" in production.
COOKIE_SECURE=false
